<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme-level brushes and colors for the application -->

    <Color x:Key="AppBackgroundColor">#FF1E1E1E</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />

    <Color x:Key="AppAccentColor">#FF0078D7</Color>
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />

</ResourceDictionary>