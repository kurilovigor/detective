<Page x:Class="Detective.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Detective.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Settings">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:Button
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Right"
            x:Name="NavigateBackButton"
            Margin="0,0,10,0">
            <ui:SymbolIcon Symbol="ArrowLeft20" />
        </ui:Button>
        <ui:TextBlock
            Grid.Row="0"
            Grid.Column="1"
            FontTypography="Title"
            Appearance="Secondary">Settings</ui:TextBlock>

        <!-- Settings content -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                <ui:TextBlock Width="150" VerticalAlignment="Center" Appearance="Secondary">Startup page:</ui:TextBlock>
                <ComboBox x:Name="StartPageComboBox" Width="200" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
